# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: stock oppo-mt6769_u_14.0_a38_a18 kernel (extracted
# with scripts/extract-ikconfig from the stock boot image), adjusted for
# postmarketOS (see git history of pmaports/device/testing/linux-oppo-a38).
maintainer=""
pkgname=linux-oppo-a38
pkgver=4.19.191
pkgrel=1
pkgdesc="Oppo A38 (CPH2579) downstream kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="oppo-a38"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	gcc6
	openssl-dev
	perl
	linux-headers
	cpio
	gzip
	xz
	python3
"

# Compiler: GCC 6. The 4.19 MTK vendor code (sched extensions etc.) does not
# build with GCC >= 10 ("inlining failed in call to 'always_inline': function
# body not available"). Same pattern as other downstream pmOS kernel ports.
if [ "${CC:0:5}" != "gcc6-" ]; then
	CC="gcc6-$CC"
	HOSTCC="gcc6-gcc"
	CROSS_COMPILE="gcc6-$CROSS_COMPILE"
fi

# Source: this repository itself. CI replaces __GITHUB_SHA__ with the commit
# being built and __SOURCE_SHA512__ with the sha512 of the archive.
_config="config-$_flavor.$arch"
source="
	$pkgname-__GITHUB_SHA__.tar.gz::https://github.com/giel-arch/Linux/archive/__GITHUB_SHA__.tar.gz
	$_config
"
builddir="$srcdir/Linux-__GITHUB_SHA__"
_outdir="out"

prepare() {
	default_prepare
	# Tree is clang-era (Android): its own compiler-gcc.h already works with
	# modern GCC, and the devicepkg-dev replacement expects the old
	# __LINUX_COMPILER_H include chain and breaks the build.
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS

	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		Image.gz mediatek/mt6768.dtb
}

package() {
	# MTK's bootloader expects a gzipped kernel image. Pick Image.gz (the
	# dtb is passed separately via the boot image dtb section, exactly like
	# the stock boot.img does).
	if [ -f "$_outdir"/arch/$_carch/boot/Image ]; then
		rm "$_outdir"/arch/$_carch/boot/Image
	fi
	mv "$_outdir"/arch/$_carch/boot/Image.gz "$_outdir"/arch/$_carch/boot/Image

	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	# Wrap the dtb into the MediaTek dtb table format (same 32 byte header
	# layout as the dtb section of the stock boot.img).
	python3 - "$_outdir"/arch/$_carch/boot/dts/mediatek/mt6768.dtb \
		"$pkgdir"/boot/dtbs/mediatek/mt6768.dtb <<'PYEOF'
import struct
import sys
import os

src, dst = sys.argv[1], sys.argv[2]
fdt = open(src, 'rb').read()
assert fdt[:4] == b'\xd0\x0d\xfe\xed', 'not a valid dtb'

total_size = 64 + len(fdt)
header = struct.pack('>8I',
    0xd7b7ab1e,   # magic (dt_table_header, MediaTek variant)
    total_size,   # total_size
    32,           # header_size
    32,           # dt_entry_size
    1,            # dt_entry_count
    32,           # dt_entries_offset
    2048,         # page_size
    0,            # version
)
entry = struct.pack('>8I',
    len(fdt),     # dt_size
    64,           # dt_offset
    0, 0, 0, 0, 0, 0,  # id, rev, custom
)
os.makedirs(os.path.dirname(dst), exist_ok=True)
open(dst, 'wb').write(header + entry + fdt)
PYEOF
}

sha512sums="
__SOURCE_SHA512__  linux-oppo-a38-__GITHUB_SHA__.tar.gz
345570bbc72dc21f5186d377c0557a1da2424a0055ea22be8645ea635b6761f11953f500cab184ed4f95be77c884fdde17be65aeb2b880ae82bcb66fab284240  config-oppo-a38.aarch64
"
